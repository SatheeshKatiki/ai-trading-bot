# ===========================================================================
#  AI Trading Bot — .gitignore
#  NEVER commit anything in the "SECRETS" sections below.
# ===========================================================================

# ---------------------------------------------------------------------------
# SECRETS — encryption keys & credentials  [NEVER COMMIT]
# ---------------------------------------------------------------------------
# Fernet encryption key (auto-generated)
.broker.key
# Encrypted broker API keys
broker_credentials.json
# Hashed dashboard password
dashboard_auth.json
# User accounts (password hashes)
users.json
# Active login session tokens
sessions.json
# Cached Fyers access token
.fyers_tokens.json
# Cached Kite access token
.kite_tokens.json
# SecurityVault master passphrase (auto-generated)
.vault_passphrase
# SecurityVault PBKDF2 salt (auto-generated)
.vault_salt
*.token
*.key
*.pem
*.p12
*.pfx

# ---------------------------------------------------------------------------
# SECRETS — environment files  [NEVER COMMIT]
# ---------------------------------------------------------------------------
.env
.env.local
.env.production
.env.staging
# .env.example  ← this IS committed (it's a template, no real values)

# ---------------------------------------------------------------------------
# Runtime state & settings (contain strategy config, may contain paths)
# ---------------------------------------------------------------------------
state.json
settings.json
# Live equity/PnL/trade history (also covered by root *.db, spelled out for clarity)
state.db
# SQLite WAL sidecars — root *.db doesn't match the "-wal"/"-shm" suffix
state.db-wal
state.db-shm
# Orphaned duplicate from an earlier path layout — not read/written anywhere
data/state.db
# Singleton-instance lock files (shared/singleton_lock.py) — PIDs, machine-specific
run/

# ---------------------------------------------------------------------------
# Audit logs (append-only, may contain order details)
# ---------------------------------------------------------------------------
audit/

# ---------------------------------------------------------------------------
# Disaster-recovery backups — contain state.db, broker_credentials.json,
# cached broker tokens, and the audit log verbatim  [NEVER COMMIT]
# ---------------------------------------------------------------------------
backups/

# ---------------------------------------------------------------------------
# Live position state — rewritten by the running engine on every
# open/close; tracking it makes git status permanently dirty while live
# and (lower severity, but still) can leak real position sizes/entries
# ---------------------------------------------------------------------------
config/active_positions.json

# ---------------------------------------------------------------------------
# Trained ML models (large binary files)
# ---------------------------------------------------------------------------
models/*.pkl
models/*.joblib
models/*.h5
models/*.pt
models/*.onnx
lstm_memory.npz
lstm_memory.pkl

# ---------------------------------------------------------------------------
# Data files (historical OHLCV — can be large)
# ---------------------------------------------------------------------------
data/*.csv
data/*.parquet
data/*.feather
# drl/train.py loads this from the repo root, not data/ -- regenerated/
# downloaded, shouldn't be committed.
nifty_historical_data.csv

# ---------------------------------------------------------------------------
# RL training run artifacts (TensorBoard logs — large, regenerated per run)
# ---------------------------------------------------------------------------
ppo_trading_tensorboard/
*_tensorboard/

# ---------------------------------------------------------------------------
# Python artefacts
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
pip-log.txt
pip-delete-this-directory.txt
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
*.cover
htmlcov/
.pytest_cache/
.mypy_cache/
.dmypy.json
dmypy.json

# ---------------------------------------------------------------------------
# Virtual environments
# ---------------------------------------------------------------------------
venv/
.venv/
env/
ENV/
.python-version

# ---------------------------------------------------------------------------
# Distribution / packaging
# ---------------------------------------------------------------------------
build/
dist/
*.egg-info/
.eggs/
MANIFEST

# ---------------------------------------------------------------------------
# IDE / editor files
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject

# ---------------------------------------------------------------------------
# OS files
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ---------------------------------------------------------------------------
# Logs (general)
# ---------------------------------------------------------------------------
*.log
logs/

# ---------------------------------------------------------------------------
# Jupyter notebooks (may contain sensitive output)
# ---------------------------------------------------------------------------
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Docker
# ---------------------------------------------------------------------------
.dockerignore

# ---------------------------------------------------------------------------
# Temporary / atomic write files
# ---------------------------------------------------------------------------
*.tmp
*.bak
*.orig

# Validation-harness trade caches: regenerable by
# `python -m validation_harness.run_dd_attribution --refresh` (~45 min for
# the full sweep), tens of MB, and superseded on every strategy change.
# The reports generated FROM them are tracked; the caches are not.
validation_harness/results/*.pkl
