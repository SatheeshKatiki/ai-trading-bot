# Copy to .env and adjust. Every value has a safe default — an empty .env
# runs the full mocked suite, which never touches the Python backend.

# ─── Target ──────────────────────────────────────────────────────────────────
# mocked (default) | live
#   mocked : real Next.js dashboard, every /api/** served from fixtures.
#   live   : real FastAPI backend on port 8000. Read-only unless you also set
#            ALLOW_MUTATIONS below.
TEST_TARGET=mocked

BASE_URL=http://localhost:3000
BACKEND_URL=http://127.0.0.1:8000

# ─── Live-mode safety ────────────────────────────────────────────────────────
# Permits POST/PUT/DELETE against the real backend: order execution, panic
# exit, settings writes, engine toggle. These change the state of a running
# trading system. Leave unset unless you are deliberately exercising one of
# them on a system you are watching. Rejected outright when CI=1.
# ALLOW_MUTATIONS=1

# Dashboard account used by live-mode specs.
TEST_USER_ID=
TEST_USER_PASSWORD=

# ─── Execution ───────────────────────────────────────────────────────────────
# Start `npm run dev` for the frontend if nothing is listening on BASE_URL.
MANAGE_FRONTEND=true
HEADLESS=true
# TEST_WORKERS=4
# TEST_RETRIES=1
# ACTION_TIMEOUT_MS=15000
# EXPECT_TIMEOUT_MS=10000
# TEST_TIMEOUT_MS=60000

# Framework-level diagnostics: mock hits, guard decisions, API timings.
# VERBOSE_LOGS=1
